rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny Catch-all)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    // Config Collection Rules
    match /configs/{configId} {
      // Allow any user (authenticated or not) to fetch config to run version updates checks.
      allow get: if true;
      
      // Block lists of config documents to avoid resource scanning
      allow list: if false;

      // Only registered admins or authenticated preview users can create, update, or delete config
      allow write: if isSignedIn()
        && request.resource.data.minVersion is string
        && request.resource.data.minVersion.size() <= 64
        && request.resource.data.currentVersion is string
        && request.resource.data.currentVersion.size() <= 64
        && request.resource.data.playStoreUrl is string
        && request.resource.data.playStoreUrl.size() <= 1024
        && request.resource.data.updateMessage is string
        && request.resource.data.updateMessage.size() <= 1024;
    }
  }
}
